# Copy to .env (local) or .env.sprite (deployed). Never commit either.

# --- Secrets you generate ------------------------------------------------------------------------
# Also used as Telegram's webhook secret, so letters, digits, _ and - only: `openssl rand -hex 32`
FP_SHARED_SECRET=
FP_CALENDAR_TOKEN=                 # `openssl rand -hex 16`; calendar feed is /calendar.ics?token=...
FP_PUBLIC_URL=                     # https://fine-print-<org>.sprites.app (from `sprite info`)
FP_TELEGRAM_TOKEN=                 # from @BotFather
FP_OWNER_CLAIM_CODE=               # `openssl rand -hex 8`; send `/start <code>` once to claim the bot
FP_JOIN_CODE=                      # `openssl rand -hex 6`; members send `/start <code>` (rotate to revoke new joins)
FP_OWNER_CHAT_ID=                  # optional: fix the owner chat instead of claiming

# --- Providers -----------------------------------------------------------------------------------
# On the Sprite: the connector gateway base for each, from scripts/connectors.sh, e.g.
#   FP_PINECONE_BASE=https://api.sprites.dev/v1/gateway/pinecone/conn_abc123
# and no keys. Locally: the provider's own URL plus a *_KEY.
FP_OPENCODE_BASE=https://opencode.ai/inference   # on the Sprite: a Custom API connector's gateway base
FP_OPENCODE_KEY=                                 # local only; on the Sprite the connector holds it
FP_PINECONE_BASE=                  # Pinecone connector gateway base
FP_PINECONE_INDEX=fine-print       # dense, 1024 dims, cosine (create once in the Pinecone console)
FP_LLAMA_BASE=https://api.cloud.llamaindex.ai   # on the Sprite: a Custom API connector's gateway base
FP_LLAMA_KEY=
FP_AGENTMAIL_BASE=                 # AgentMail connector gateway base (local: https://api.agentmail.to)
FP_AGENTMAIL_KEY=                  # local only
FP_AGENTMAIL_INBOX_ID=             # the shared inbox's id
FP_AGENTMAIL_ADDRESS=              # e.g. fineprint@agentmail.to
FP_AGENTMAIL_WEBHOOK_SECRET=       # whsec_... from the AgentMail webhook (message.received)
FP_EXA_BASE=                       # Exa connector gateway base (local: https://api.exa.ai)
FP_EXA_KEY=                        # local only
FP_LLAMA_PROJECT_ID=

# --- Tuning ---------------------------------------------------------------------------------------
FP_JUDGE_MODEL=jev-1.14           # TypeSafe Jev via OpenCode
FP_WRITER_MODEL=deepseek-v4.1-flash  # 60% off on OpenCode Zen; zero data retention per Zen docs
FP_MATERIAL_THRESHOLD=0.7
